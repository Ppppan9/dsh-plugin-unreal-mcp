{
  "name": "dsh-unreal-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "Drive a live Unreal Editor from DeepSeek Harness via Unreal's built-in ModelContextProtocol MCP server. Reverse-engineered from Epic's official Claude Code plugin.",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./index.js": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./icon.svg": "./icon.svg",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "skills/**",
    "LICENSE-Epic-Games-MIT.txt",
    "NOTICE.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "unreal",
    "unreal-engine",
    "mcp",
    "modelcontextprotocol",
    "ai-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ppppan9/dsh-unreal-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Ppppan9/dsh-unreal-mcp/issues"
  },
  "homepage": "https://github.com/Ppppan9/dsh-unreal-mcp#readme"
}
